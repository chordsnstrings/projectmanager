// Cadence data model (spec §5). PostgreSQL 17 in production.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  lead
  dev
}

// A team is the unit of visibility + activity taxonomy (e.g. programming, marketing).
model Team {
  id        String    @id @default(cuid())
  key       String    @unique // registry key: 'programming' | 'marketing' | ...
  name      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  users     User[]
  tasks     Task[]
  meetings  Meeting[]
}

enum TaskSource {
  issue
  pr
  branch
  manual
}

enum TaskStatus {
  todo
  in_progress
  in_review
  done
}

enum ActivitySource {
  inferred
  manual
}

enum GitEventType {
  commit
  pr_opened
  pr_merged
  pr_closed
  pr_review
  push
  release
}

enum FlagType {
  open_no_activity
  activity_no_session
  long_open_session
  overrun
  duplicate_session
}

enum FlagStatus {
  open
  resolved
  dismissed
}

enum QuestionStatus {
  open
  answered
}

model User {
  id          String      @id @default(cuid())
  githubId    BigInt      @unique
  githubLogin String      @unique
  name        String?
  email       String?
  avatarUrl   String?
  role        Role        @default(dev)
  stopOnCommit Boolean    @default(false) // auto-close a task's open session when a commit lands
  timezone    String?     // IANA tz id (e.g. "Asia/Karachi"); day boundaries, idle + digests use the user's local time
  lastLoginAt DateTime?   // most recent GitHub sign-in — drives the login-reminder emails
  githubAccessToken String? // OAuth token, AES-256-GCM encrypted at rest (per-user sync)
  teamId      String?     // null only until onboarding picks a team
  team        Team?       @relation(fields: [teamId], references: [id])
  lastSeenVersion String?  // most recent changelog version this user has acknowledged
  tourSeenAt  DateTime?   // finished/skipped the first-login walkthrough
  emails      UserEmail[]
  sessions    Session[]
  taskMemberships TaskMember[]
  taskComments TaskComment[]
  dailyCheckins DailyCheckin[]
  pushSubscriptions PushSubscription[]
  meetingsCreated Meeting[]  @relation("MeetingCreator")
  meetingAttendance MeetingAttendee[]
  flags       Flag[]
  questions   Question[]  @relation("QuestionTarget")
  createdAt   DateTime    @default(now())
  deletedAt   DateTime?

  @@index([teamId])
}

model UserEmail {
  // alias resolution for commit-author matching
  id     String @id @default(cuid())
  email  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Installation {
  id                   String    @id @default(cuid())
  githubInstallationId BigInt    @unique
  accountLogin         String
  repos                Repo[]
  createdAt            DateTime  @default(now())
  deletedAt            DateTime?
}

model Repo {
  id             String       @id @default(cuid())
  githubRepoId   BigInt       @unique
  fullName       String
  defaultBranch  String       @default("main")
  latestVersion  String? // most recent release tag/name (e.g. "v1.4.0")
  latestVersionAt DateTime?
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id])
  tasks          Task[]
  gitEvents      GitEvent[]
  connectedAt    DateTime     @default(now())
  deletedAt      DateTime?
}

model Task {
  id              String     @id @default(cuid())
  repoId          String? // null for manual (non-git) tasks
  repo            Repo?      @relation(fields: [repoId], references: [id])
  source          TaskSource
  githubNumber    Int? // issue/PR number; null for pure-branch tasks
  branch          String? // branch name when source = branch/pr/manual+git
  title           String // canonical title synced from git, OR admin-set for manual tasks
  displayTitle    String? // Cadence-local rename override (never pushed to GitHub)
  status          TaskStatus @default(todo)
  assigneeUserId  String? // primary owner
  createdByUserId String? // admin who created a manual task (audit)
  teamId          String? // set for manual tasks; git tasks derive team from the assignee
  team            Team?   @relation(fields: [teamId], references: [id])
  estimateMinutes Int? // §7
  description     String? // the giver's raw task request / brief
  plan            String? // AI-generated step-by-step (markdown), editable
  planApproved    Boolean   @default(false) // the giver approved the plan for the assignee
  planApprovedById String?
  planApprovedAt  DateTime?
  // Cached AI "is this specified enough?" verdict (soft gate at handoff/claim).
  specReady       Boolean?
  specScore       Int?
  specMissing     String? // JSON array of gaps
  specQuestions   String? // JSON array of clarifying questions
  specCheckedAt   DateTime?
  specDescHash    String? // hash of the description the verdict was computed for
  milestoneTitle  String? // GitHub milestone (often a version, e.g. "v1.2") — completion grouping
  milestoneDueOn  DateTime?
  reopenCount     Int        @default(0)
  createdAt       DateTime   @default(now())
  closedAt        DateTime?
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  sessions        Session[]
  gitEvents       GitEvent[]
  members         TaskMember[]
  comments        TaskComment[]

  @@unique([repoId, source, githubNumber, branch])
  @@index([assigneeUserId, status])
  @@index([teamId, source, assigneeUserId])
}

// Morning "start your day" check-in: yesterday reflection + today's plan.
model DailyCheckin {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  localDate     String    // YYYY-MM-DD in the user's timezone (the day of the check-in)
  skipped       Boolean   @default(false)
  productivity  Int? // 1..5 self-rating of yesterday
  blocker       String? // chip key: review | requirements | bug | meetings | none | other
  blockerNote   String?
  focus         String? // free-text focus for today
  focusTaskIds  String? // JSON array of task ids
  confidence    Int? // 1..5 confidence in today's plan
  carryover     String? // JSON: [{ taskId, status: on_track|blocked|dropping }]
  yesterdayActiveMinutes Int? // measured snapshot for felt-vs-measured
  yesterdayCompleted     Int?
  createdAt     DateTime  @default(now())

  @@unique([userId, localDate])
  @@index([userId, localDate])
}

// A browser/PWA Web Push subscription (one per device/browser per user).
model PushSubscription {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  endpoint  String    @unique // push service URL; the subscription identity
  p256dh    String    // client public key (base64url)
  auth      String    // client auth secret (base64url)
  userAgent String?   // best-effort label for the device list
  createdAt DateTime  @default(now())
  deletedAt DateTime? // soft-deleted when the push service reports it's gone (404/410)

  @@index([userId])
}

// A meeting scheduled by a manager for specific people at a future time.
model Meeting {
  id              String    @id @default(cuid())
  title           String
  agenda          String?
  location        String? // room or video link
  scheduledAt     DateTime // UTC start time
  durationMinutes Int       @default(30)
  teamId          String? // organizing team (creator's team) — scopes lead management
  team            Team?     @relation(fields: [teamId], references: [id])
  createdByUserId String
  createdBy       User      @relation("MeetingCreator", fields: [createdByUserId], references: [id])
  canceledAt      DateTime?
  reminderSentAt  DateTime? // dedupes the pre-start reminder push
  createdAt       DateTime  @default(now())
  attendees       MeetingAttendee[]

  @@index([scheduledAt])
  @@index([teamId, scheduledAt])
}

model MeetingAttendee {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@index([userId])
}

// A discussion comment on a task (giver ↔ receiver back-and-forth).
model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([taskId, createdAt])
}

// Additional collaborators on a task (the primary owner is Task.assigneeUserId).
model TaskMember {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([taskId, userId])
  @@index([userId])
}

model Session {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  taskId       String? // null only for off-task sessions
  task         Task?             @relation(fields: [taskId], references: [id])
  offTaskLabel String? // when taskId is null (research, meeting…)
  startedAt    DateTime
  endedAt      DateTime?
  isOpen       Boolean           @default(true)
  intent       String?
  summary      String?
  blocked      Boolean           @default(false)
  segments     ActivitySegment[]
  meetingMinutes MeetingMinutes?
  createdAt    DateTime          @default(now())
  deletedAt    DateTime?

  @@index([userId, startedAt])
}

// Minutes of a meeting (MoM) — captured before a `meeting` off-task session may
// be stopped. Hard-required: the session cannot end without minutes on file.
model MeetingMinutes {
  id        String   @id @default(cuid())
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id])
  date      String // YYYY-MM-DD meeting date (defaults to the session's start day)
  attendees String // "Members" present
  agenda    String
  createdAt DateTime @default(now())
  items     MeetingMinutesItem[]

  @@index([sessionId])
}

// One agenda row of a MoM (topic → decision). All fields required.
model MeetingMinutesItem {
  id          String         @id @default(cuid())
  minutesId   String
  minutes     MeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  order       Int // display order within the MoM
  topic       String
  details     String
  decision    String
  responsible String
  timeline    String
  remarks     String
  taskId      String? // set when this action item has been turned into a trackable task

  @@index([minutesId])
}

model ActivitySegment {
  id        String         @id @default(cuid())
  sessionId String
  session   Session        @relation(fields: [sessionId], references: [id])
  type      String // team-specific activity key, validated against the @cadence/shared registry
  source    ActivitySource @default(inferred)
  startedAt DateTime
  endedAt   DateTime
}

model GitEvent {
  id           String       @id @default(cuid())
  repoId       String
  repo         Repo         @relation(fields: [repoId], references: [id])
  taskId       String? // resolved by attribution (§6)
  task         Task?        @relation(fields: [taskId], references: [id])
  authorUserId String? // resolved by githubId/email
  type         GitEventType
  sha          String?
  prNumber     Int?
  branch       String?
  additions    Int?
  deletions    Int?
  filesChanged Int?
  message      String?
  occurredAt   DateTime
  deliveryId   String?      @unique // webhook idempotency
  raw          Json?
  createdAt    DateTime     @default(now())

  @@index([repoId, occurredAt])
  @@index([taskId])
}

model Flag {
  id         String     @id @default(cuid())
  type       FlagType
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  sessionId  String?
  taskId     String?
  gitEventId String?
  detail     String
  status     FlagStatus @default(open)
  createdAt  DateTime   @default(now())
  resolvedAt DateTime?

  @@index([userId, status])
}

model Question {
  id           String         @id @default(cuid())
  adminUserId  String
  targetUserId String
  targetUser   User           @relation("QuestionTarget", fields: [targetUserId], references: [id])
  taskId       String? // null → the question is about a session (e.g. off-task work)
  sessionId    String?
  body         String
  blocksNext   Boolean        @default(true) // gates the dev's next task completion
  status       QuestionStatus @default(open)
  answer       String?
  createdAt    DateTime       @default(now())
  answeredAt   DateTime?

  @@index([targetUserId, status])
}
