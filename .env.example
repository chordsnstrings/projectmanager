# ── Cadence environment (§11) ──────────────────────────────────────────────
# Copy to .env for local dev. All secrets must be Encrypted in DigitalOcean.

# Postgres (DO Managed PG injects ${db.DATABASE_URL} in prod)
DATABASE_URL=postgresql://postgres@localhost:5433/cadence

# Public base URL of the deployed app (used for OAuth callback + webhook URL)
APP_BASE_URL=http://localhost:8080

# Signed httpOnly session cookie secret (long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# GitHub App + OAuth (§4)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Bootstrap admins: comma-separated GitHub logins auto-promoted to admin on sign-in
ADMIN_GITHUB_LOGINS=chordsnstrings

# Tunables (plain; defaults live in code)
IDLE_MINUTES=90
MAX_OPEN_HOURS=8
OVERRUN_FACTOR=1.5

# Server
PORT=8080
NODE_ENV=development
